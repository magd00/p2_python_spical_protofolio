# Copy this file to .env and fill in real values for local development.
# In production (Render, PythonAnywhere, etc.), set these in the host's
# environment variable / secrets dashboard instead of committing a .env file.

# A long, random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-secret-key

# Local dev default (SQLite file, resets if the host's disk isn't persistent):
DATABASE_URL=sqlite:///portfolio.db

# Example for a managed Postgres instance (Render, Supabase, Neon, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: set to False on real hosts to disable Flask's debugger/reloader
FLASK_DEBUG=True
